# ============================================
# CONFIGURACIÓN DEL BOT DE FINANZAS
# ============================================
# Copia este archivo a .env y completa tus datos

# 📱 Token de Telegram (obtenido de @BotFather)
TELEGRAM_TOKEN=tu_token_de_bot_aqui

# 📱 Tu Chat ID de Telegram (obtenido de @userinfobot)
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# 📧 Configuración de Gmail
GMAIL_USER=tu_email@gmail.com
GMAIL_PASS=tu_contraseña_de_aplicación_aqui

# 🤖 API Key de Google Gemini
# Obtén la clave en: https://makersuite.google.com/app/apikeys
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
